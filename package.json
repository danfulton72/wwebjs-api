{
  "name": "wwebjs-api",
  "version": "1.1.0",
  "description": "REST API wrapper for whatsapp-web.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand --config jest.config.js",
    "test:integration": "jest --runInBand --config jest.integration.config.js",
    "test:coverage": "jest --runInBand --config jest.config.js --coverage",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "npm sbom --sbom-format=cyclonedx > sbom.cdx.json",
    "check": "npm run lint && npm run test:coverage && npm run audit:prod",
    "swagger": "node swagger.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pino": "^10.3.1",
    "qr-image": "^3.2.0",
    "qrcode-terminal": "^0.12.0",
    "swagger-ui-express": "^5.0.1",
    "whatsapp-web.js": "^1.34.7",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "supertest": "^7.2.2",
    "swagger-autogen": "^2.23.7"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "wwebjs",
    "api",
    "wrapper",
    "rest",
    "express",
    "axios"
  ],
  "author": {
    "name": "Anton Voylenko",
    "email": "anton.voylenko@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danfulton72/wwebjs-api.git"
  },
  "bugs": {
    "url": "https://github.com/danfulton72/wwebjs-api/issues"
  },
  "homepage": "https://github.com/danfulton72/wwebjs-api"
}
