## Application ##
PORT=3000

# REQUIRED FOR NORMAL OPERATION. Use a strong random value.
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# DEVELOPMENT-ONLY escape hatch. Keep FALSE in production.
ALLOW_INSECURE_NO_AUTH=FALSE

# Webhooks are disabled in this example so the service can start safely before
# a callback target is configured. Set both values when enabling webhooks.
ENABLE_WEBHOOK=FALSE
# BASE_WEBHOOK_URL=https://example.internal/wwebjs/events

# Development/test callback endpoint. Keep FALSE in production.
ENABLE_LOCAL_CALLBACK_EXAMPLE=FALSE

# Global request rate limiting.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Maximum active or starting WhatsApp sessions in this process.
MAX_SESSIONS=10

# High-risk compatibility features. Keep FALSE unless you have an explicit need.
ENABLE_UNSAFE_RUN_METHOD=FALSE
ENABLE_REMOTE_MEDIA_URL=FALSE

## Client ##
MAX_ATTACHMENT_SIZE=10000000
SET_MESSAGES_AS_SEEN=TRUE
DISABLED_CALLBACKS=message_ack|message_reaction|unread_count|message_edit|message_ciphertext

# Leave WEB_VERSION empty to allow whatsapp-web.js to select its supported web version.
# WEB_VERSION=
WEB_VERSION_CACHE_TYPE=none
RECOVER_SESSIONS=TRUE
CHROME_BIN=
HEADLESS=TRUE
RELEASE_BROWSER_LOCK=TRUE
LOG_LEVEL=info
ENABLE_WEBSOCKET=FALSE
AUTO_START_SESSIONS=TRUE

## Session File Storage ##
SESSIONS_PATH=./sessions

## Optional interfaces ##
ENABLE_SWAGGER_ENDPOINT=FALSE
ENABLE_WEB_UI=FALSE

## Reverse Proxy / Load Balancer ##
BASE_PATH=/
TRUST_PROXY=FALSE

## CORS / Browser Origins ##
# Empty means no cross-origin CORS access. Same-origin and server-to-server
# requests continue to work. Use exact origins, comma separated.
# ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com

## Outbound Proxy ##
# PROXY_URL=http://10.0.0.10:8118
# PROXY_USERNAME=
# PROXY_PASSWORD=
